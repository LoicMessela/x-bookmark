# Jabba's Docs folder: "X Bookmarks" (Google Docs sink)
# https://drive.google.com/drive/folders/1sF85Lq7kU9y8y73GPyNqFl9I2ACayQBG
DRIVE_FOLDER_ID=1sF85Lq7kU9y8y73GPyNqFl9I2ACayQBG

# Jabba's Obsidian vault on Drive (phone): "Obsidian Vault - X Bookmarks"
# Real .md files — not converted to Google Docs.
# https://drive.google.com/drive/folders/1fzceV_WpXsNSOwNk_GgiXhlP2D668li6
OBSIDIAN_DRIVE_FOLDER_ID=1fzceV_WpXsNSOwNk_GgiXhlP2D668li6

# Optional: docs | obsidian (CLI --sink / --obsidian wins over this)
# X_BOOKMARK_SINK=docs

# Local dry-run directory. Default: preview-out (docs) or vault-preview (obsidian)
# OUTPUT_DIR=preview-out

# Live sync auth (pick one). Do not commit the JSON key or tokens.
# Service account: share BOTH Drive folders with the SA email, then:
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
#
# User ADC (local laptop): gcloud auth application-default login
#   --scopes=https://www.googleapis.com/auth/drive,https://www.googleapis.com/auth/documents
